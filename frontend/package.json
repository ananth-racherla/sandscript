{
  "name": "sandscript-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Sandscript web UI",
  "type": "module",
  "scripts": {
    "wasm:build": "cd .. && wasm-pack build --target web --out-dir frontend/src/wasm",
    "predev": "npm run wasm:build",
    "dev": "vite",
    "prebuild": "npm run wasm:build",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.27",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
